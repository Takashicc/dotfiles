[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[user]
	name = Takashicc
	email = 105186894+Takashicc@users.noreply.github.com
	signingkey = FFB493A9CFE01B61AB3F4B8E6810DF45BA4CA3EF
[alias]
	st = status
	ps = push
	cm = commit
	sw = !git branch | fzf | xargs git switch
	ch = checkout
	br = branch
	brd = !git branch | fzf -m | xargs -I {} git branch -d '{}'
	df = diff
	pu = pull
	gl = log --graph --oneline --decorate=full -20 --date=short --format=\"%C(yellow)%h%C(reset) %C(magenta)[%ad]%C(reset)%C(auto)%d%C(reset) %s %C(cyan)@%an%C(reset)\"
	show-stale = "!git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | sort"
	cleanup-stale = "!git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | sort | xargs git branch -d"
	aicommit = "!f() { COMMITMSG=$(codex e -m 'gpt-5.4-mini' 'Generate ONLY a one-line Git commit message in English, using imperative mood, summarizing what was changed and why, based strictly on the contents of `git diff --cached`. Do not add explanation or a body. Output only the commit summary line.'); git commit -m \"$COMMITMSG\" -e; }; f"
[pull]
	ff = only
[core]
	longpaths = true
	untrackedcache = true
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[commit]
	gpgsign = true
[ghq]
	vcs = git
	root = ~/Desktop/ghq
